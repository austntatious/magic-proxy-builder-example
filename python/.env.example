# Required: Your Magic wallet private key (from reveal.magic.link/polymarket)
POLYMARKET_MAGIC_PK=0x...your_private_key_here

# Required: Builder API credentials (from Polymarket Builders Program)
POLYMARKET_BUILDER_API_KEY=your_api_key
POLYMARKET_BUILDER_SECRET=your_base64_secret
POLYMARKET_BUILDER_PASSPHRASE=your_passphrase

# Optional: Custom Polygon RPC endpoint (defaults to public RPC)
POLYGON_RPC_URL=https://polygon-rpc.com
